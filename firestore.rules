rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function self(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid}/profile/{docId} {
      allow read: if signedIn();
      allow write: if self(uid);
    }
    match /users/{uid}/hobbies/{id} {
      allow read, write: if self(uid);
    }
    match /users/{uid}/goals/{id} {
      allow read, write: if self(uid);
    }
    match /users/{uid}/logs/{id} {
      allow read, write: if self(uid);
    }
    match /users/{uid}/stats/{id} {
      allow read: if self(uid);
      allow write: if false;
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
    match /posts/{postId}/likes/{uid} {
      allow read: if signedIn();
      allow create, delete: if self(uid);
    }
    match /posts/{postId}/comments/{commentId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
  }
}